  <diagram name="Page-1" id="GzOQ-ka7IZHZkom2q74O">
    <mxGraphModel dx="5989" dy="2775" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nnamespace Endpoints {\n  class UsersGetEndpoint {\n    +GetRequest req\n    +Configure()\n    +HandleAsync(req, ct)\n  }\n  class GetRequest {\n    +Guid? Id\n    +Guid? DepartmentId\n    +Guid? GradeId\n    +Guid? LocationId\n    +string? Country\n    +string? Region\n    +string? NetworkAccount\n    +string? Email\n    +string? Role\n    +int Limit = 100\n    +int Offset = 0\n    +ToQuery() GetUsersQuery\n  }\n  class UserCreateEndpoint {\n    +Configure()\n    +HandleAsync(req, ct)\n  }\n  class UserUpdateEndpoint {\n    +Configure()\n    +HandleAsync(req, ct)\n  }\n  class UserDeleteEndpoint {\n    +Configure()\n    +HandleAsync(req, ct)\n  }\n  class UserUpsertEndpoint {\n    +Configure()\n    +HandleAsync(req, ct)\n  }\n}\n\nnamespace Handlers {\n  class GetUsersQueryHandler {\n    -IUserRepository repository\n    -GetUsersQueryValidator Validator\n    +Handle(request, ct) Result~Page~\n    -Clean(value) string\n  }\n  class UpdateUserCommandHandler {\n    -IUserRepository repository\n    -IUnitOfWork unitOfWork\n    +Handle(request, ct) Result~UserResponse~\n  }\n  class DeleteUserCommandHandler {\n    -IUserRepository usersRepository\n    -IUnitOfWork unitOfWork\n    +Handle(request, ct) Result~UserResponse~\n  }\n  class UpsertUsersCommandHandler {\n    -IUserRepository repository\n    -IUnitOfWork unitOfWork\n    +Handle(request, ct) Result~PagedResult~\n  }\n}\n\nnamespace Repositories {\n  class IUserRepository {\n    &lt;&lt;interface&gt;&gt;\n    +AddAsync(entity, ct) Result~User~\n    +AddRangeAsync(entities, ct) Result~IEnumerable~User~~\n    +GetByIdAsync(id, ct, includes) Result~User~\n    +GetByNetworkAccountAsync(account, ct, includes) Result~User~\n    +GetByEmailAsync(email, ct, includes) Result~User~\n    +UpsertAsync(users, ct) Result~IReadOnlyList~User~~\n    +GetPagedIncludingAsync(predicate, offset, limit, ct, includes) Result~PagedUsers~\n  }\n  class UserRepository {\n    -UsersDbContext context\n    +GetByIdAsync(id, ct, includes) Result~User~\n    +GetByEmailAsync(email, ct, includes) Result~User~\n    +GetByNetworkAccountAsync(account, ct, includes) Result~User~\n    +GetPagedIncludingAsync(predicate, offset, limit, ct, includes) Result~PagedUsers~\n    +UpsertAsync(users, ct) Result~IReadOnlyList~User~~\n    +DeleteAsync(entity, ct) Result\n  }\n  class User {\n    +Guid Id\n    +string NetworkAccount\n    +string Email\n    +Guid? DepartmentId\n    +Guid? GradeId\n    +Guid? LocationId\n    +string EmployeeWorkCountry\n    +string SubRegion\n    +UpdateUserData(data)\n    +ToResponse() UserResponse\n  }\n  class UsersDbContext\n  class IUnitOfWork {\n    &lt;&lt;interface&gt;&gt;\n    +SaveChangesAsync(ct)\n    +BeginTransactionAsync(ct)\n    +CommitTransactionAsync(ct)\n    +RollbackTransactionAsync(ct)\n  }\n}\n\nUsersGetEndpoint --&gt; GetRequest : binds query parameters\nGetRequest ..&gt; GetUsersQuery : ToQuery()\nUsersGetEndpoint --&gt; GetUsersQueryHandler : sends query\nUserCreateEndpoint ..&gt; IUserRepository : via IAccountService\nUserUpdateEndpoint --&gt; UpdateUserCommandHandler : sends command\nUserDeleteEndpoint --&gt; DeleteUserCommandHandler : sends command\nUserUpsertEndpoint --&gt; UpsertUsersCommandHandler : sends command\nGetUsersQueryHandler --&gt; IUserRepository : filters and pages\nUpdateUserCommandHandler --&gt; IUserRepository : load/update user\nUpdateUserCommandHandler --&gt; IUnitOfWork : transaction\nDeleteUserCommandHandler --&gt; IUserRepository : load/delete user\nDeleteUserCommandHandler --&gt; IUnitOfWork : transaction\nUpsertUsersCommandHandler --&gt; IUserRepository : upsert users\nUpsertUsersCommandHandler --&gt; IUnitOfWork : transaction\nUserRepository ..|&gt; IUserRepository : implements\nUserRepository --&gt; UsersDbContext : EF Core\nUserRepository ..&gt; User : persists\nIUserRepository ..&gt; User : returns\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hTRsD6afLqAbtdx8ti8Z-2">
